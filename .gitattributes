# Prototype: laravel/Modules/* e laravel/Themes/*
# Sync: bash bashscripts/templates/sync-gitattributes-modules.sh
#
# Git LFS VIETATO. Binari = blob git normali.
# Mai: filter=lfs / diff=lfs / merge=lfs

* text=auto

*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored

CHANGELOG.md export-ignore

# `binary` + `!filter` azzera eventuali filtri LFS ereditati
*.png binary !filter
*.jpg binary !filter
*.jpeg binary !filter
*.gif binary !filter
*.webp binary !filter
*.ico binary !filter
*.svg binary !filter
*.psd binary !filter
*.pdf binary !filter
*.zip binary !filter
*.woff binary !filter
*.woff2 binary !filter
*.ttf binary !filter
*.eot binary !filter
*.otf binary !filter
*.phar binary !filter
*.db binary !filter
*.sqlite binary !filter
